{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "UTC",
  "schedule": [],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Base image and Terraform tooling"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python tools"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "ansible-core"
      ],
      "allowedVersions": ">=2.18.0 <2.19.0"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "ansible-lint"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "molecule",
        "molecule-plugins"
      ],
      "allowedVersions": "<6.1.0",
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "docker"
      ],
      "allowedVersions": ">=6.1.0 <7.0.0",
      "rangeStrategy": "pin"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm version pin in Dockerfile",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "HELM_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Kustomize version pin in Dockerfile",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "KUSTOMIZE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "extractVersionTemplate": "^kustomize/v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Vault version pin in Dockerfile",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "VAULT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/vault",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "modulix-automation-runtime COPR RPM pin",
      "managerFilePatterns": [
        "/copr-packages\\.txt$/"
      ],
      "matchStrings": [
        "modulix-automation-runtime-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-1\\.el9\\.noarch"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "lightning-it/modulix-automation",
      "extractVersionTemplate": "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "versioningTemplate": "semver"
    }
  ]
}
