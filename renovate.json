{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitType(chore)",
    ":semanticCommitScope(deps)"
  ],
  "renovate-config": {
    "enabled": false
  },
  "labels": ["dependencies", "renovate"],
  "baseBranchPatterns": ["develop"],
  "timezone": "UTC",
  "schedule": [],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Automerge safe non-major updates into develop after CI passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "addLabels": ["safe-automerge"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require manual approval for major updates",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-update"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm version pin in Dockerfile",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": ["HELM_VERSION=(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Kustomize version pin in Dockerfile",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": ["KUSTOMIZE_VERSION=(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "extractVersionTemplate": "^kustomize/v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Vault version pin in Dockerfile",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": ["VAULT_VERSION=(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/vault",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "modulix-automation-runtime COPR RPM pin",
      "managerFilePatterns": ["/copr-packages\\.txt$/"],
      "matchStrings": [
        "modulix-automation-runtime-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-1\\.el9\\.noarch"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "lightning-it/modulix-automation",
      "extractVersionTemplate": "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "versioningTemplate": "semver"
    }
  ]
}
